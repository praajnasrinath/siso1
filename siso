class test;

    environment env;

    function new(virtual siso_if vif);

        env = new(vif);

    endfunction

    task run();

        $display("-------------------------------------");
        $display("Starting SISO Verification");
        $display("-------------------------------------");

        fork
            env.run();
        join_none

        #300;

        $display("-------------------------------------");
        $display("Verification Completed");
        $display("-------------------------------------");

        $finish;

    endtask

endclass
Purpose
Creates the verification environment.
Starts the simulation.
Runs all verification components.
Stops the simulation after a fixed time.
9. Top Testbench (tb_top.sv)
`timescale 1ns/1ps

module tb_top;

logic clk;

// Clock Generation
always #5 clk = ~clk;

// Interface
siso_if vif(clk);

// DUT Instantiation
siso dut(
    .clk(clk),
    .rst(vif.rst),
    .serial_in(vif.serial_in),
    .serial_out(vif.serial_out)
);

// Test Handle
test t;

initial
begin

    clk = 0;

    // Apply Reset
    vif.rst = 1;
    vif.serial_in = 0;

    #20;

    vif.rst = 0;

    // Create Test
    t = new(vif);

    // Start Verification
    t.run();

end

// Waveform Dump
initial
begin
    $dumpfile("siso.vcd");
    $dumpvars(0, tb_top);
end

endmodule
